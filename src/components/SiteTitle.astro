---
// the love.fund lockup: split heart + goopy rose "love" + hard-edged gray ".fund", then a small "docs" tag
import heart from '../assets/heart.svg?raw';
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" aria-label="love.fund docs, home">
	<span class="mark" set:html={heart} />
	<span class="word" translate="no"><span class="love">love</span><span class="fund">.fund</span></span>
	<span class="tag">docs</span>
</a>

<style>
	.site-title {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}
	.mark :global(svg) {
		display: block;
		height: 1.7rem;
		width: auto;
	}
	/* the mark's light grays vanish on paper, so darken them in light mode */
	:global(:root[data-theme='light']) .mark :global([stroke='#cfc4bb']) {
		stroke: oklch(48% 0.015 40);
	}
	:global(:root[data-theme='light']) .mark :global([fill='#cfc4bb']) {
		fill: oklch(48% 0.015 40);
	}
	:global(:root[data-theme='light']) .mark :global([stroke='#f0e9e2']) {
		stroke: oklch(40% 0.12 20);
	}
	.word {
		font-size: 1.45rem;
		line-height: 1;
	}
	.love {
		font-family: 'DynaPuff', 'Fraunces', serif;
		font-weight: 600;
		color: var(--lf-rose);
	}
	.fund {
		font-family: 'Chakra Petch', sans-serif;
		font-weight: 600;
		font-size: 0.94em;
		letter-spacing: 0.02em;
		color: var(--sl-color-gray-2);
	}
	.tag {
		font-family: 'Chakra Petch', sans-serif;
		font-weight: 600;
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		padding: 0.15rem 0.5rem;
		margin-left: 0.2rem;
	}
</style>
