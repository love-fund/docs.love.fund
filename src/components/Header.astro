---
// starlight's header, with a full-width "designed in the open" strip across the very top of the page.
// the strip sits inside the fixed <header> (absolutely positioned at its top edge), and theme.css
// grows --sl-nav-height by --lf-banner-h so the sidebar, toc and content all start below it.
import Default from '@astrojs/starlight/components/Header.astro';
---

<div class="lf-banner" role="note" data-pagefind-ignore>
	<p>
		<span class="lf-banner__dot" aria-hidden="true"></span>
		<strong>love.fund is being designed in the open.</strong>
		<span class="lf-banner__more">
			These are our working docs and things are changing fast. Expect a firmer path forward by Q1 2027.
		</span>
		<a href="/reference/get-involved/">Get involved →</a>
	</p>
	<button type="button" class="lf-banner__close" aria-label="Dismiss this notice" title="Dismiss">
		<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
			<path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"></path>
		</svg>
	</button>
</div>
<script is:inline>
	(function () {
		// dismissing hides the strip for 90 days (Head.astro reads this before first paint)
		var DAYS = 90;
		var btn = document.querySelector('.lf-banner__close');
		if (!btn) return;
		btn.addEventListener('click', function () {
			try {
				localStorage.setItem('lf-banner-dismissed-until', String(Date.now() + DAYS * 864e5));
			} catch (e) {}
			document.documentElement.setAttribute('data-lf-banner-hidden', '');
		});
	})();
</script>
<Default />

<style>
	.lf-banner {
		/* the same quiet orange as the old in-page notice */
		--lf-banner-bg: oklch(26% 0.045 55);
		--lf-banner-edge: oklch(45% 0.09 58);
		--lf-banner-accent: oklch(76% 0.14 60);
		position: absolute;
		inset-block-start: 0;
		inset-inline: 0;
		height: var(--lf-banner-h);
		display: flex;
		align-items: center;
		justify-content: center;
		padding-inline: calc(var(--sl-nav-pad-x) + 2rem);
		background: var(--lf-banner-bg);
		border-bottom: 1px solid var(--lf-banner-edge);
		color: var(--sl-color-gray-2);
		font-family: var(--sl-font);
		font-size: var(--sl-text-sm);
		line-height: 1.3;
	}
	:global([data-theme='light']) .lf-banner {
		--lf-banner-bg: oklch(96% 0.03 65);
		--lf-banner-edge: oklch(85% 0.07 62);
		--lf-banner-accent: oklch(60% 0.15 50);
	}
	.lf-banner p {
		margin: 0;
		min-width: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.lf-banner__dot {
		display: inline-block;
		width: 0.45rem;
		height: 0.45rem;
		margin-inline-end: 0.4rem;
		border-radius: 999px;
		background: var(--lf-banner-accent);
		vertical-align: 0.1em;
	}
	.lf-banner strong {
		font-family: var(--sl-font-display);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.lf-banner__more {
		display: none;
	}
	.lf-banner a {
		margin-inline-start: 0.4rem;
		color: var(--lf-banner-accent);
		font-weight: 600;
		text-underline-offset: 0.2em;
	}
	.lf-banner a:hover {
		color: var(--sl-color-white);
	}
	.lf-banner__close {
		position: absolute;
		inset-inline-end: 0.5rem;
		top: 50%;
		transform: translateY(-50%);
		display: grid;
		place-items: center;
		width: 1.6rem;
		height: 1.6rem;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--sl-color-gray-3);
		cursor: pointer;
	}
	.lf-banner__close:hover {
		background: var(--lf-banner-edge);
		color: var(--sl-color-white);
	}
	.lf-banner__close:focus-visible {
		outline: 2px solid var(--lf-banner-accent);
		outline-offset: 2px;
	}
	:global(:root[data-lf-banner-hidden]) .lf-banner {
		display: none;
	}
	@media (min-width: 72rem) {
		.lf-banner__more {
			display: inline;
		}
	}
</style>
