---
// a redirect page that still unfurls: link previews (telegram, x, slack…) don't follow
// meta refreshes, so the page itself carries the destination's title, description and card.
interface Props {
	to: string; // destination path, may include a #hash
	title: string;
	description: string;
	card: string; // og/<card>.png
}
const { to, title, description, card } = Astro.props;
const image = new URL(`/og/${card}.png`, Astro.site).href;
const url = new URL(Astro.url.pathname, Astro.site).href;
const canonical = new URL(to.split('#')[0], Astro.site).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta name="robots" content="noindex" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="love.fund docs" />
		<meta property="og:url" content={url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta http-equiv="refresh" content={`0;url=${to}`} />
	</head>
	<body>
		<a href={to}>{title} →</a>
	</body>
</html>
