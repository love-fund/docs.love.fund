---
// the single pager: every docs page, end to end, in sidebar order.
// it's generated at build time from src/content/docs by walking src/sidebar.mjs,
// so any page that's in the sidebar shows up here automatically. don't hand-edit content here.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, render } from 'astro:content';
import { sidebar } from '../../sidebar.mjs';

const docs = (await getCollection('docs')).filter((d) => !d.data.draft);
const byId = new Map(docs.map((d) => [d.id, d]));

// same ordering starlight uses for autogenerated groups: sidebar.order, then path
const order = (d) => d.data.sidebar?.order ?? Number.POSITIVE_INFINITY;
function inDirectory(dir) {
	return docs
		.filter((d) => d.id.startsWith(`${dir}/`) && !d.data.sidebar?.hidden)
		.sort((a, b) => (order(a) === order(b) ? a.id.localeCompare(b.id) : order(a) - order(b)));
}

function collect(items, out = []) {
	for (const item of items) {
		if (typeof item === 'string') out.push(byId.get(item));
		else if (item.slug) out.push(byId.get(item.slug));
		else if (item.autogenerate) out.push(...inDirectory(item.autogenerate.directory));
		else if (item.items) collect(item.items, out);
		// plain { link } items (like this page) aren't docs entries
	}
	return out.filter(Boolean);
}

const anchor = (id) => `page-${id.replace(/\//g, '-')}`;
const groups = await Promise.all(
	sidebar.map(async (group) => ({
		label: group.label,
		id: `group-${group.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`,
		pages: await Promise.all(
			collect(group.items).map(async (entry) => ({ entry, ...(await render(entry)) })),
		),
	})),
);

const headings = groups.flatMap((g) => [
	{ depth: 2, slug: g.id, text: g.label },
	...g.pages.map((p) => ({ depth: 3, slug: anchor(p.entry.id), text: p.entry.data.title })),
]);
---

<StarlightPage
	frontmatter={{
		title: 'Single Pager',
		description: 'Everything on docs.love.fund on one page, end to end, in sidebar order.',
		tableOfContents: { minHeadingLevel: 2, maxHeadingLevel: 3 },
	}}
	headings={headings}
>
	{
		groups.map((g) => (
			<section class="sp-group">
				<h2 id={g.id} class="sp-group__title">{g.label}</h2>
				{g.pages.map(({ entry, Content }) => (
					<article class="sp-page">
						<a class="sp-page__path" href={`/${entry.id}/`}>/{entry.id}/</a>
						<h3 class="sp-page__title" id={anchor(entry.id)}>{entry.data.title}</h3>
						{entry.data.description && <p class="sp-page__desc">{entry.data.description}</p>}
						<Content />
					</article>
				))}
			</section>
		))
	}
	<script is:inline>
		// each page's own h2/h3s carry ids, and starlight's "on this page" tracker treats any h2/h3 with an id
		// as a marker. those aren't in this page's toc, so the highlight would stick. move their ids onto the
		// heading wrapper div: in-page anchors still work, and only group and page titles drive the toc.
		document.querySelectorAll('.sp-page .sl-heading-wrapper > :is(h2, h3)[id]').forEach(function (h) {
			h.parentElement.id = h.id;
			h.removeAttribute('id');
		});
	</script>
</StarlightPage>

<style>
	.sp-group__title {
		margin-top: 3.5rem;
		padding-bottom: 0.4rem;
		border-bottom: 2px solid var(--sl-color-accent);
		font-family: var(--sl-font-fund);
		font-size: var(--sl-text-sm);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--sl-color-accent);
	}
	.sp-page {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--sl-color-hairline);
	}
	.sp-group__title + .sp-page {
		border-top: 0;
		padding-top: 0;
		margin-top: 1.5rem;
	}
	.sp-page__path {
		display: inline-block;
		font-family: var(--sl-font-fund);
		font-size: var(--sl-text-xs);
		letter-spacing: 0.06em;
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.sp-page__path:hover {
		color: var(--sl-color-accent);
	}
	.sp-page__title {
		margin-top: 0.25rem;
		font-size: var(--sl-text-h2);
	}
	.sp-page__desc {
		margin-top: 0.5rem;
		font-style: italic;
		color: var(--sl-color-gray-2);
	}
</style>
