---
// old /start-here/<slug>/ urls. the ontology pages moved from /start-here/ to /ontology/, and the dialectics
// before that lived at /start-here/<dialectic>/. these redirects carry the destination's social card, so old links still unfurl.
import { getEntry } from 'astro:content';
import Redirect from '../../components/Redirect.astro';
import { DIALECTICS } from './dialectics/[legacy].astro';

export function getStaticPaths() {
	const PAGES = ['beliefs', 'fund-what-matters', 'beyond-dualism', 'dialectic', 'upward-spiral'];
	return [
		{ params: { legacy: 'ontology' }, props: { id: 'ontology', hash: '' } },
		...PAGES.map((slug) => ({ params: { legacy: slug }, props: { id: `ontology/${slug}`, hash: '' } })),
		...DIALECTICS.map((slug) => ({ params: { legacy: slug }, props: { id: `ontology/dialectics/${slug}`, hash: '' } })),
		// the old "from → to" page is now a section of the sacred economy dialectic
		{ params: { legacy: 'from-to' }, props: { id: 'ontology/dialectics/sacred-global-economy', hash: '#towards-a-more-sacred-economy' } },
	];
}

const { id, hash } = Astro.props;
const entry = await getEntry('docs', id);
if (!entry) throw new Error(`legacy redirect target missing: ${id}`);
---

<Redirect
	to={`/${id}/${hash}`}
	title={entry.data.title}
	description={entry.data.description ?? ''}
	card={id.replace(/\//g, '-')}
/>
